# Copy to `.env` (never commit it). Every variable is optional.
# Names only — never put real values in this file.

# Overrides the data folder (SQLite database, backups, config).
# Default: OS data folder (%APPDATA%/GameBacklog, ~/Library/Application Support/GameBacklog,
# ~/.local/share/GameBacklog). Must be outside the repository.
GAMEBACKLOG_DATA_DIR=

# Local server address. Defaults: 127.0.0.1 and 3777.
GAMEBACKLOG_HOST=
GAMEBACKLOG_PORT=

# Where API keys are kept. Default: the OS keychain, falling back to a restricted file in the
# data folder when the system has no keychain. Set to "file" to always use the file.
GAMEBACKLOG_SECRET_STORE=
